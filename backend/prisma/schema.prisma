// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model PlatformCommissionPolicy {
  // One global policy record, identified by "global".
  id String @id @default("global")

  // 100 basis points = 1%.
  // Required: there is deliberately no default commission rate.
  rateBps Int

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id           String    @id @default(cuid())
  phone        String    @unique
  password     String?
  isVerified   Boolean   @default(false)
  hasStore     Boolean   @default(false)
  name         String?
  email        String?   @unique
  avatar       String?
  otp          String?
  role         UserRole  @default(USER)
  otpExpiresAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  refreshSessions RefreshSession[]
  store           Store?
  cart            Cart?
  orders          Order[]
  addresses       Address[]

  wallet       Wallet?
  payments     Payment[]
  bankAccounts BankAccount[]
  withdrawals  Withdrawal[]
  refunds      Refund[]

  Notifications Notification[]

  storeReviews StoreReview[]
  storeFollows StoreFollow[]

  buyerEscrows  Escrow[] @relation("BuyerEscrows")
  sellerEscrows Escrow[] @relation("SellerEscrows")

  buyerDisputes  Dispute[] @relation("BuyerDisputes")
  sellerDisputes Dispute[] @relation("SellerDisputes")

  deliveryEvidenceSubmitted DeliveryEvidence[] @relation("SellerDeliveryEvidence")

  storeReports         StoreReport[] @relation("StoreReportReporter")
  reviewedStoreReports StoreReport[] @relation("StoreReportReviewer")

  auditLogs  AuditLog[]
  kycProfile KycProfile? @relation("UserKycProfile")
}

enum UserRole {
  USER
  ADMIN
}

model RefreshSession {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String @unique

  expiresAt DateTime
  revokedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([expiresAt])
}

//Order
model Order {
  id String @id @default(cuid())

  orderNumber String @unique

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Restrict)

  status        OrderStatus   @default(PENDING)
  paymentStatus PaymentStatus @default(PENDING)
  paymentMethod PaymentMethod

  subtotal    Decimal @db.Decimal(14, 2)
  deliveryFee Decimal @default(0) @db.Decimal(14, 2)
  discount    Decimal @default(0) @db.Decimal(14, 2)
  total       Decimal @db.Decimal(14, 2)

  currency String @default("NGN")

  deliveryType     DeliveryType
  deliveryProvider DeliveryProvider?

  deliveryAddressSnapshot Json?
  deliveryNote            String?

  deliveryEstimateMin Int?
  deliveryEstimateMax Int?

  sellerDeliveryFee Decimal @default(0) @db.Decimal(14, 2)
  roaDeliveryFee    Decimal @default(0) @db.Decimal(14, 2)

  cancellationReason String?

  estimatedAt DateTime?
  deliveredAt DateTime?

  paymentReference String?

  hasReviewed Boolean @default(false)

  buyerSnapshot Json?
  storeSnapshot Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items    OrderItem[]
  tracking OrderTracking[]

  storeReview StoreReview?

  escrow Escrow?

  payments Payment[]

  refunds Refund[]

  dispute Dispute?

  storeReports StoreReport[]

  auditLogs        AuditLog[]
  deliveryEvidence DeliveryEvidence[]

  @@index([userId])
  @@index([storeId])
  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
  @@index([orderNumber])
}

model OrderItem {
  id String @id @default(cuid())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  productName  String
  productSlug  String?
  productImage String?

  quantity Int

  unitPrice Decimal @db.Decimal(14, 2)
  subtotal  Decimal @db.Decimal(14, 2)

  variant Json?

  disputeItems DisputeItem[]

  status OrderItemStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([productId])
}

model OrderTracking {
  id String @id @default(cuid())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  status OrderStatus

  note String?

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([createdAt])
}

enum OrderStatus {
  PENDING
  CONFIRMED
  IN_DELIVERY
  DELIVERED
  CANCELLED
  RETURNED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentMethod {
  WALLET
  CARD
  BANK_TRANSFER
}

enum OrderItemStatus {
  ACTIVE
  CANCELLED
  RETURNED
}

// store
model Store {
  id String @id @default(cuid())

  name    String
  slug    String  @unique
  handle  String? @unique
  tagline String?
  about   String? @db.Text

  logo       String?
  coverImage String?

  email    String?
  whatsapp String?
  location String?

  category StoreCategory?

  isOpen     Boolean     @default(true)
  isVerified Boolean     @default(false)
  status     StoreStatus @default(PENDING)

  ratingStars   Decimal @default(0) @db.Decimal(3, 2)
  ratingCount   Int     @default(0)
  followerCount Int     @default(0)

  // General estimated delivery time
  deliveryDaysMin Int?
  deliveryDaysMax Int?

  // Pickup
  pickupEnabled      Boolean @default(false)
  pickupAddress      String?
  pickupInstructions String?

  ownerId String @unique
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  products Product[]

  reviews   StoreReview[]
  followers StoreFollow[]

  deliveryRules DeliveryRule[]

  cartItems CartItem[]

  socialLinks Json?
  bankDetails Json?
  policies    Json?

  reports          StoreReport[]
  promotions       StorePromotion[]
  productDiscounts ProductDiscount[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders    Order[]

  @@index([status])
  @@index([category])
  @@index([isVerified])
  @@index([pickupEnabled])
  @@index([createdAt])
}

model DeliveryRule {
  id String @id @default(cuid())

  storeId String

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  scope DeliveryRuleScope @default(STATE)

  stateCode String?
  zoneCode  String?

  fee Decimal @db.Decimal(14, 2)

  currency String @default("NGN")

  isActive Boolean @default(true)

  priority Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([storeId])
  @@index([storeId, isActive])
  @@index([stateCode])
  @@index([zoneCode])
  @@index([scope])
}

model Category {
  id String @id @default(cuid())

  name     String  @unique
  slug     String  @unique
  isActive Boolean @default(true)

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([createdAt])
}

enum StoreStatus {
  PENDING
  ACTIVE
  SUSPENDED
  CLOSED
  REJECTED
}

enum StoreCategory {
  GENERAL
  FASHION
  ELECTRONICS
  SPORTS
  BEAUTY
  HOME
  AUTOMOTIVE
  FOOD
  SERVICES
  EDUCATION
  HEALTH
  TRAVEL
  ENTERTAINMENT
  ART
  AGRICULTURE
  MUSIC
  REAL_ESTATE
  OTHER
}

//Delivery
enum DeliveryRuleScope {
  STATE
  ZONE
  NATIONWIDE
}

enum DeliveryProvider {
  SELLER
  ROA
  THIRD_PARTY
}

model Address {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  recipientName String
  phone         String

  addressLine1 String
  addressLine2 String?

  city        String
  stateCode   String?
  countryCode String  @default("NG")

  landmark String?

  isDefault Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

enum DeliveryType {
  DELIVERY
  PICKUP
}

//product
model Product {
  id String @id @default(cuid())

  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  type ProductType @default(REGULAR)

  name        String
  slug        String
  description String @db.Text

  images Json

  price    Decimal  @db.Decimal(14, 2)
  oldPrice Decimal? @db.Decimal(14, 2)

  costPrice Decimal? @db.Decimal(14, 2)

  condition ProductCondition @default(BRAND_NEW)
  status    ProductStatus    @default(DRAFT)

  stock Int?

  ratingStars Decimal @default(0) @db.Decimal(3, 2)
  ratingCount Int     @default(0)

  soldCount Int @default(0)

  keywords Json?

  variants Json?

  hasVariants Boolean @default(false)

  location String?

  listingMeta Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  productVariants ProductVariant[]
  discount        ProductDiscount?

  cartItems  CartItem[]
  orderItems OrderItem[]

  @@unique([storeId, slug])
  @@index([storeId])
  @@index([categoryId])
  @@index([type])
  @@index([status])
  @@index([condition])
  @@index([price])
  @@index([ratingStars])
  @@index([soldCount])
  @@index([createdAt])
}

model ProductVariant {
  id String @id @default(cuid())

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  combination Json

  price Decimal @db.Decimal(14, 2)
  stock Int     @default(0)

  sku String

  discountPriceSnapshot ProductDiscountVariantPrice?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, sku])
  @@index([productId])
  @@index([stock])
}

enum ProductType {
  REGULAR
  REALESTATE
  CAR
}

enum ProductCondition {
  BRAND_NEW
  LIKE_NEW
  GOOD
  FAIR
  USED
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
  HIDDEN
}

//Cart
model Cart {
  id String @id @default(cuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  items CartItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CartItem {
  id String @id @default(cuid())

  cartId String
  cart   Cart   @relation(fields: [cartId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Restrict)

  quantity Int @default(1)

  unitPrice Decimal @db.Decimal(14, 2)

  /**
   * Canonical representation of the selected variant.
   * Example:
   * Colours=Beige|Sizes=M
   */
  variantKey String?

  variant Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cartId])
  @@index([productId])
  @@index([storeId])
  @@index([cartId, productId])
  @@index([variantKey])
}

enum WalletOwnerType {
  USER
  PLATFORM
}

enum WalletLedgerType {
  TOPUP
  PURCHASE_HOLD
  ESCROW_RELEASE
  REFUND
  WITHDRAWAL
  COMMISSION
  ADJUSTMENT
}

enum WalletLedgerStatus {
  PENDING
  COMPLETED
  FAILED
  REVERSED
}

enum EscrowStatus {
  HELD
  RELEASE_PENDING
  RELEASED
  REFUND_PENDING
  REFUNDED
  PARTIALLY_REFUNDED
  DISPUTED
  CANCELLED
}

enum PaymentType {
  ORDER
  WALLET_TOPUP
  WITHDRAWAL
  REFUND
}

enum PaymentProvider {
  PAYSTACK
}

enum FinancialPaymentStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum WithdrawalStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum RefundType {
  FULL
  PARTIAL
}

enum RefundStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED_BUYER
  RESOLVED_SELLER
  PARTIALLY_RESOLVED
  CLOSED
}

enum AuditActorType {
  USER
  ADMIN
  SYSTEM
}

model Wallet {
  id String @id @default(cuid())

  ownerType WalletOwnerType @default(USER)

  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  availableBalance Decimal @default(0) @db.Decimal(14, 2)
  heldBalance      Decimal @default(0) @db.Decimal(14, 2)
  currency         String  @default("NGN")

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ledgerEntries WalletLedger[]
  withdrawals   Withdrawal[]
}

model WalletLedger {
  id String @id @default(cuid())

  walletId String
  wallet   Wallet @relation(fields: [walletId], references: [id], onDelete: Restrict)

  type   WalletLedgerType
  status WalletLedgerStatus @default(PENDING)

  amount   Decimal @db.Decimal(14, 2)
  currency String  @default("NGN")

  availableBalanceBefore Decimal @db.Decimal(14, 2)
  availableBalanceAfter  Decimal @db.Decimal(14, 2)

  heldBalanceBefore Decimal @db.Decimal(14, 2)
  heldBalanceAfter  Decimal @db.Decimal(14, 2)

  orderId      String?
  escrowId     String?
  paymentId    String?
  withdrawalId String?
  refundId     String?

  refund Refund?

  reference      String @unique
  idempotencyKey String @unique

  description String?
  metadata    Json?

  createdAt DateTime @default(now())
}

model Escrow {
  id String @id @default(cuid())

  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Restrict)

  buyerId String
  buyer   User   @relation("BuyerEscrows", fields: [buyerId], references: [id], onDelete: Restrict)

  sellerId String
  seller   User   @relation("SellerEscrows", fields: [sellerId], references: [id], onDelete: Restrict)

  amount   Decimal @db.Decimal(14, 2)
  currency String  @default("NGN")

  status EscrowStatus @default(HELD)

  heldAt DateTime @default(now())

  releaseEligibleAt DateTime?
  releasedAt        DateTime?
  refundedAt        DateTime?

  releasedAmount Decimal? @db.Decimal(14, 2)
  refundedAmount Decimal? @db.Decimal(14, 2)

  releaseReason String?
  refundReason  String?

  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  refunds  Refund[]
  disputes Dispute[]
}

model Payment {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: Restrict)

  type     PaymentType
  provider PaymentProvider
  status   FinancialPaymentStatus @default(PENDING)

  amount   Decimal @db.Decimal(14, 2)
  currency String  @default("NGN")

  providerReference String? @unique
  providerEventId   String? @unique

  idempotencyKey String @unique

  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  refunds Refund[]
}

model BankAccount {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  bankCode String
  bankName String

  accountName String

  accountNumberLast4 String

  providerRecipientCode String?

  isVerified Boolean @default(false)
  isDefault  Boolean @default(false)
  isActive   Boolean @default(true)

  verifiedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  withdrawals Withdrawal[]

  @@index([userId])
}

model Withdrawal {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  walletId String
  wallet   Wallet @relation(fields: [walletId], references: [id], onDelete: Restrict)

  bankAccountId String
  bankAccount   BankAccount @relation(fields: [bankAccountId], references: [id], onDelete: Restrict)

  amount   Decimal @db.Decimal(14, 2)
  currency String  @default("NGN")

  status WithdrawalStatus @default(PENDING)

  providerReference String? @unique
  idempotencyKey    String  @unique

  requestedAt DateTime  @default(now())
  processedAt DateTime?

  failureReason String?

  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Refund {
  id String @id @default(cuid())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Restrict)

  escrowId String?
  escrow   Escrow? @relation(fields: [escrowId], references: [id], onDelete: Restrict)

  paymentId String?
  payment   Payment? @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  type   RefundType
  status RefundStatus @default(PENDING)

  amount   Decimal @db.Decimal(14, 2)
  currency String  @default("NGN")

  reason String?

  walletLedgerId String?       @unique
  walletLedger   WalletLedger? @relation(fields: [walletLedgerId], references: [id], onDelete: Restrict)

  providerReference String? @unique
  idempotencyKey    String  @unique

  processedAt DateTime?

  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Dispute {
  id String @id @default(cuid())

  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Restrict)

  escrowId String
  escrow   Escrow @relation(fields: [escrowId], references: [id], onDelete: Restrict)

  buyerId String
  buyer   User   @relation("BuyerDisputes", fields: [buyerId], references: [id], onDelete: Restrict)

  sellerId String
  seller   User   @relation("SellerDisputes", fields: [sellerId], references: [id], onDelete: Restrict)

  reason DisputeReason
  status DisputeStatus @default(OPEN)

  description String @db.Text

  evidence Json?

  sellerResponse String?

  resolutionNote String?

  adminReviewNote String?
  reviewedAt      DateTime?

  approvedRefundAmount Decimal? @db.Decimal(14, 2)

  items DisputeItem[]

  resolutionOutcome         DisputeResolutionOutcome?
  deliveryFeeRefundEligible Boolean?

  resolvedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DisputeItem {
  id String @id @default(cuid())

  disputeId String
  dispute   Dispute @relation(fields: [disputeId], references: [id], onDelete: Cascade)

  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  // Quantity claimed by the buyer.
  claimedQuantity Int

  // Quantity verified and approved by the admin.
  // Null means the dispute item has not been resolved.
  approvedQuantity Int?

  // Admin selects the verified outcome, never a refund amount.
  outcome DisputeItemOutcome?

  // Calculated by ROA when the dispute is resolved.
  calculatedRefundAmount Decimal? @db.Decimal(14, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([disputeId, orderItemId])
  @@index([orderItemId])
}

enum DisputeItemOutcome {
  REJECTED
  MINOR_DEFECT
  MODERATE_DEFECT
  MAJOR_DEFECT_OR_MISMATCH
  UNUSABLE_OR_FUNDAMENTALLY_DIFFERENT
  MISSING_ITEM
}

enum DisputeReason {
  WRONG_ITEM
  DAMAGED
  DEFECTIVE
  NOT_AS_DESCRIBED
  MISSING_ITEM
  QUALITY_ISSUE
  DELIVERY_ISSUE
  NON_DELIVERY
  OTHER
}

enum DisputeResolutionOutcome {
  REJECTED
  PRODUCT_COMPENSATION
  SELLER_RESPONSIBLE_NON_DELIVERY
}

model AuditLog {
  id String @id @default(cuid())

  actorType AuditActorType
  actorId   String?

  action String

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  orderId      String?
  escrowId     String?
  paymentId    String?
  walletId     String?
  withdrawalId String?
  refundId     String?
  disputeId    String?

  reference String?

  metadata Json?

  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())
  order     Order?   @relation(fields: [orderId], references: [id])

  @@index([actorId])
  @@index([userId])
  @@index([orderId])
  @@index([escrowId])
  @@index([paymentId])
  @@index([walletId])
  @@index([createdAt])
}

enum KycStatus {
  NOT_STARTED
  PENDING
  VERIFIED
  REJECTED
  SUSPENDED
}

enum KycVerificationType {
  PHONE
  IDENTITY
  BANK_ACCOUNT
}

enum KycVerificationStatus {
  PENDING
  VERIFIED
  FAILED
  EXPIRED
}

enum KycProvider {
  INTERNAL
  EXTERNAL
}

model KycProfile {
  id String @id @default(cuid())

  userId String @unique
  user   User   @relation("UserKycProfile", fields: [userId], references: [id], onDelete: Cascade)

  status KycStatus @default(NOT_STARTED)

  identityVerified Boolean @default(false)
  bankVerified     Boolean @default(false)

  withdrawalPinHash  String?
  withdrawalPinSetAt DateTime?

  verifiedAt  DateTime?
  rejectedAt  DateTime?
  suspendedAt DateTime?

  rejectionReason  String?
  suspensionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  verifications KycVerification[]
}

model KycVerification {
  id String @id @default(cuid())

  kycProfileId String
  kycProfile   KycProfile @relation(fields: [kycProfileId], references: [id], onDelete: Cascade)

  type   KycVerificationType
  status KycVerificationStatus @default(PENDING)

  provider          KycProvider @default(INTERNAL)
  providerReference String?

  verifiedValue String?
  failureReason String?

  expiresAt  DateTime?
  verifiedAt DateTime?

  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([kycProfileId])
  @@index([type])
  @@index([status])
  @@index([providerReference])
}

enum DeliveryEvidenceStatus {
  PENDING_REVIEW
  ACCEPTED
  REJECTED
}

model DeliveryEvidence {
  id String @id @default(cuid())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Restrict)

  sellerId String
  seller   User   @relation("SellerDeliveryEvidence", fields: [sellerId], references: [id], onDelete: Restrict)

  evidenceType  String
  fileUrls      Json?
  recipientName String?
  deliveryNote  String?

  status DeliveryEvidenceStatus @default(PENDING_REVIEW)

  submittedAt  DateTime  @default(now())
  reviewedAt   DateTime?
  reviewedById String?
  reviewNote   String?

  buyerNotifiedAt       DateTime?
  buyerResponseDeadline DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([sellerId])
  @@index([status, buyerResponseDeadline])
}

enum NotificationChannel {
  IN_APP
  TELEGRAM
  WHATSAPP
}

enum NotificationDeliveryStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

model Notification {
  id String @id @default(cuid())

  recipientId String
  recipient   User   @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  // Examples: DELIVERY_EVIDENCE_ACCEPTED, ORDER_CONFIRMED, DISPUTE_OPENED
  type String

  title   String
  message String

  // Optional navigation and event context for the future frontend.
  data Json?

  // Allows the same business event to be retried safely.
  dedupeKey String? @unique

  readAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deliveries NotificationDelivery[]

  @@index([recipientId, readAt, createdAt])
  @@index([type, createdAt])
}

model NotificationDelivery {
  id String @id @default(cuid())

  notificationId String
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  channel NotificationChannel

  status NotificationDeliveryStatus @default(PENDING)

  attempts Int @default(0)

  lastAttemptAt DateTime?
  sentAt        DateTime?

  // Provider-specific message ID, e.g. a Telegram message ID.
  externalMessageId String?

  // Store a safe error summary if delivery fails.
  lastError String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([notificationId, channel])
  @@index([status, createdAt])
  @@index([channel, status])
}

enum StoreReportStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  DISMISSED
}

enum StoreReportReason {
  FRAUD_OR_SCAM
  MISLEADING_LISTING
  COUNTERFEIT_OR_PROHIBITED
  SELLER_MISCONDUCT
  REPEATED_CANCELLATIONS
  DELIVERY_OR_FULFILMENT
  POOR_PRODUCT_QUALITY
  OTHER
}

model StoreReport {
  id String @id @default(cuid())

  reporterId String
  reporter   User   @relation("StoreReportReporter", fields: [reporterId], references: [id], onDelete: Restrict)

  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Restrict)

  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)

  reason      StoreReportReason
  description String            @db.Text

  status StoreReportStatus @default(OPEN)

  adminNotes   String? @db.Text
  reviewedById String?
  reviewedBy   User?   @relation("StoreReportReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  reviewedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([reporterId, createdAt])
  @@index([storeId, status, createdAt])
  @@index([orderId])
  @@index([status, createdAt])
  @@index([reviewedById])
}

model StoreReview {
  id      String @id @default(cuid())
  storeId String
  userId  String
  orderId String @unique

  rating  Int
  comment String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Restrict)
  user  User  @relation(fields: [userId], references: [id], onDelete: Restrict)
  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([storeId, createdAt])
  @@index([userId, createdAt])
  @@index([rating])
}

model StoreFollow {
  userId     String
  storeId    String
  followedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@id([userId, storeId])
  @@index([storeId, followedAt])
  @@index([userId, followedAt])
}

enum StorePromotionStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model StorePromotion {
  id      String @id @default(cuid())
  storeId String

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  title    String
  message  String? @db.Text
  imageUrl String?

  ctaLabel String?
  ctaUrl   String?

  status StorePromotionStatus @default(DRAFT)

  startsAt DateTime?
  endsAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([storeId, status, createdAt])
  @@index([startsAt, endsAt])
}

enum ProductDiscountStatus {
  ACTIVE
  ENDED
}

model ProductDiscount {
  id            String                @id @default(cuid())
  storeId       String
  productId     String                @unique
  percentage    Int
  originalPrice Decimal               @db.Decimal(12, 2)
  status        ProductDiscountStatus @default(ACTIVE)
  startsAt      DateTime              @default(now())
  endsAt        DateTime?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  variantPriceSnapshots ProductDiscountVariantPrice[]

  store   Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([storeId, status, createdAt])
  @@index([status, startsAt, endsAt])
}

model ProductDiscountVariantPrice {
  id               String   @id @default(cuid())
  discountId       String
  productVariantId String   @unique
  originalPrice    Decimal  @db.Decimal(12, 2)
  createdAt        DateTime @default(now())

  discount ProductDiscount @relation(fields: [discountId], references: [id], onDelete: Cascade)

  productVariant ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Cascade)

  @@index([discountId])
}
